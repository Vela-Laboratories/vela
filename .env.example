# =====================================================================
# Vela Exchange — environment variables
#
# Copy to .env.local (root) and fill in real values. All variables are
# optional unless marked REQUIRED. See docs/env-vars.md for details.
# =====================================================================

# -- Core ops ---------------------------------------------------------
PORT=3001
# Use 127.0.0.1 for private, on-demand staging.
VELA_BIND_HOST=0.0.0.0
SNAPSHOT_DIR=/data
DA_DIR=/data/da
VELA_EXPORT_DIR=/data/exports
# Exact Git SHA or release identity. Required when recovery replication is enabled.
VELA_BUILD_ID=
# Must be a non-nested path; production should use a separate mount/failure domain.
VELA_ENGINE_REPLICA_DIR=
VELA_ENGINE_REPLICA_TIMEOUT_MS=30000
# Dedicated secp256k1 signing key and matching compressed public key (hex).
VELA_RECOVERY_SIGNING_KEY_HEX=
VELA_RECOVERY_VERIFYING_KEY_HEX=
# Optional encrypted age/X25519 archive sink. Production requires both values.
VELA_ENGINE_OFFSITE_DIR=
VELA_RECOVERY_AGE_RECIPIENT=

# -- Auth / admin -----------------------------------------------------
# REQUIRED to boot the api crate in tests and to unlock admin endpoints.
ADMIN_TOKEN=ci-admin-token

# -- Chain & contract --------------------------------------------------
VELA_CHAIN_ID=11155111
# REQUIRED only for `ledger-bootstrap`; use the native USDC contract for this chain.
VELA_USDC_ADDRESS=
VELA_SETTLEMENT_ADDRESS=0xAa8E680c11a883F9bf6eb980B2D4E9D18DD25686
# Legacy alias for VELA_SETTLEMENT_ADDRESS; keep for compat.
VELA_CONTRACT_ADDRESS=0xAa8E680c11a883F9bf6eb980B2D4E9D18DD25686
# JSON array of allowlisted bridge contract addresses.
VELA_BRIDGE_ALLOWLIST=[]
ALCHEMY_API_URL=https://eth-sepolia.g.alchemy.com/v2/demo
# Operator signing key for withdrawal signatures and anchor tx signing.
# Leave empty in dev; anchor task disables itself when unset.
OPERATOR_PRIVATE_KEY=
# Public operator address (derived from the private key). Some paths
# accept either OPERATOR_ADDRESS or OPERATOR_WALLET_ADDRESS.
OPERATOR_ADDRESS=
OPERATOR_WALLET_ADDRESS=

# -- Batch dispatcher tuning ------------------------------------------
VELA_BATCH_WINDOW_US=500
VELA_BATCH_MAX_SIZE=256
VELA_ORDER_CHANNEL_SIZE=8192
VELA_FEED_CHANNEL_SIZE=4096
VELA_DISPATCH_TIMEOUT_MS=1000
VELA_SPEED_BUMP_US=0

# -- Price feed --------------------------------------------------------
VELA_PYTH_ENABLED=true

# -- Committee (TEOB) -------------------------------------------------
VELA_THRESHOLD_T=15
VELA_THRESHOLD_N=21
VELA_COMMITTEE_PUBKEY=
# Per-node HMAC auth keys (VELA_COMMITTEE_KEY_0 .. VELA_COMMITTEE_KEY_{N-1}).
VELA_COMMITTEE_KEY_0=

# -- Portfolio margin --------------------------------------------------
VELA_PM_MAINT_BPS=500
VELA_PM_INITIAL_BPS=1000
VELA_PM_CORR_ETH_BTC=80
VELA_PM_CORR_SOL_BTC=60

# -- Credit system ----------------------------------------------------
VELA_CREDIT_WINDOW_MS=30000
VELA_MAX_CREDIT_PER_BP_MICRO_USDC=1000000000

# -- Verifiability providers (fail-closed on prod when unset) ---------
# ZKVM_PROVIDER=placeholder|sp1
ZKVM_PROVIDER=placeholder
VELA_PROVER=placeholder
VELA_SP1_PROVER_URL=
VELA_SP1_VERIFIER_URL=
VELA_SP1_ELF_ID=
# TEE_PLATFORM=placeholder|amd-sev-snp
TEE_PLATFORM=placeholder

# -- FIX gateway ------------------------------------------------------
VELA_FIX_BIND=0.0.0.0:5001
VELA_FIX_COMP_ID=VELA
VELA_FIX_HEARTBEAT_S=30

# -- RFQ venue --------------------------------------------------------
VELA_RFQ_MAKERS=
VELA_RFQ_MAKER_MIN_SCORE_BPS=7000
VELA_RFQ_MIN_NOTIONAL_MICRO=250000000000

# -- Toxicity gating --------------------------------------------------
VELA_TOX_AMBER_THRESHOLD=60
VELA_TOX_RED_THRESHOLD=85
VELA_TOX_AMBER_EXTRA_BUMP_US=250

# -- Listings / reputation --------------------------------------------
VELA_LISTING_BOND_MICRO=1000000000
VELA_LISTING_CHALLENGE_HOURS=48
VELA_REPUTATION_TTL_MS=86400000

# -- Runtime / observability ------------------------------------------
# development: no synthetic balances/books; testnet-demo: demo liquidity;
# production: strict startup validation and JSON tracing.
VELA_RUNTIME_MODE=testnet-demo
# Legacy alias. ENVIRONMENT=production remains fail-closed for compatibility.
# ENVIRONMENT=development
RUST_LOG=info,api=debug

# -- Authoritative ledger ---------------------------------------------
# Optional in development/testnet-demo; REQUIRED in production.
# Use the restricted writer role here. Never use the database owner.
DATABASE_URL=
# Used only by the controlled migration binary/workflow, never by api.
DATABASE_MIGRATOR_URL=
VELA_DATABASE_MAX_CONNECTIONS=10
VELA_DATABASE_ACQUIRE_TIMEOUT_MS=2000
VELA_DATABASE_STATEMENT_TIMEOUT_MS=2000
VELA_DATABASE_SERIALIZABLE_RETRIES=3
VELA_CUSTODY_VAULT_ADDRESS=
VELA_CUSTODY_VAULT_DEPLOYMENT_VERSION=
VELA_CUSTODY_VAULT_CODE_HASH=
VELA_CUSTODY_VAULT_START_BLOCK=

# -- Base deposit indexer ---------------------------------------------
# A fixed UUID generated once per immutable deployment registry row.
VELA_INDEXER_DEPLOYMENT_ID=
# Supported values are base (8453) and base-sepolia (84532).
VELA_INDEXER_NETWORK=
# Two independently operated RPC providers are required. Provider URLs are secrets.
VELA_BASE_RPC_PRIMARY_NAME=
VELA_BASE_RPC_PRIMARY_URL=
VELA_BASE_RPC_SECONDARY_NAME=
VELA_BASE_RPC_SECONDARY_URL=
VELA_INDEXER_RPC_TIMEOUT_MS=5000
VELA_INDEXER_POLL_MS=2000
VELA_INDEXER_RETRY_MAX_MS=30000
VELA_INDEXER_MAX_HEAD_AGE_SECONDS=120
VELA_INDEXER_MAX_PROVIDER_BLOCK_LAG=3
VELA_INDEXER_BATCH_SIZE=500
# Maximum previously processed finalized block range re-audited per tick.
VELA_INDEXER_AUDIT_BATCH_SIZE=500
VELA_INDEXER_LEASE_SECONDS=30
