MANIFEST_VERSION=1
ENVIRONMENT=production
CUSTODY_MILESTONE=M5_V3_OMNIBUS
DATABASE_ENGINE=postgresql
DATABASE_MAJOR_VERSION=16
PRIMARY_FAILURE_DOMAIN=zone-a
STANDBY_FAILURE_DOMAIN=zone-b
OFFSITE_FAILURE_DOMAIN=region-c
PRIVATE_NETWORKING=enabled
TLS_ENFORCED=enabled
WRITER_ROLE_SEPARATION=verified
READER_ROLE_SEPARATION=verified
MIGRATOR_ROLE_SEPARATION=verified
WRITER_CREDENTIAL_REFERENCE=secret-ref-writer-production
READER_CREDENTIAL_REFERENCE=secret-ref-reader-production
MIGRATOR_CREDENTIAL_REFERENCE=secret-ref-migrator-production
MIGRATOR_APPROVAL=required
SYNCHRONOUS_REPLICATION=enabled
AUTOMATED_BACKUPS=enabled
BACKUP_ENCRYPTION=enabled
PITR=disabled
PITR_RETENTION_DAYS=35
OFFSITE_BACKUP_EXPORT=enabled
OFFSITE_BACKUP_ENCRYPTION=enabled
RESTORE_REHEARSAL=passed
PITR_REHEARSAL=passed
FAILOVER_REHEARSAL=passed
IN_FLIGHT_FINANCIAL_RECOVERY_REHEARSAL=passed
RESTORE_EVIDENCE_REFERENCE=incident-20260919-dr-001
PAGING_DESTINATION=verified
PAGING_DELIVERY_REHEARSAL=passed
PAGING_EVIDENCE_REFERENCE=incident-20260919-page-001
RPO_TARGET=zero_acknowledged_operations
LEDGER_RTO_MINUTES=30
TRADING_RTO_MINUTES=60
RUNBOOK_APPROVAL=two_person
OPS_OWNER_REFERENCE=ops-team-reference
